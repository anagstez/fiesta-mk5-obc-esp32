/*
 * ST7789P3 2.25" 76x284 on ESP32-S3 — Mac system monitor over USB-Serial/JTAG
 *  - host (tools/sysmon.py) sends "M <cpu%> <ram%> <rx KB/s> <tx KB/s> <bat%>\n" once a second
 *  - 5 sections: current value + 72-sample history graph
 *  - redraws only when a packet arrives (or the link goes stale)
 */
#include <stdio.h>
#include <string.h>
#include "freertos/FreeRTOS.h"
#include "freertos/task.h"
#include "freertos/semphr.h"
#include "driver/spi_master.h"
#include "driver/gpio.h"
#include "driver/ledc.h"
#include "driver/usb_serial_jtag.h"
#include "esp_lcd_panel_io.h"
#include "esp_lcd_panel_ops.h"
#include "esp_lcd_panel_vendor.h"
#include "esp_heap_caps.h"
#include "esp_attr.h"
#include "esp_log.h"

static const char *TAG = "sysmon";

#define PIN_SCK   12
#define PIN_MOSI  11
#define PIN_CS    10
#define PIN_DC     9
#define PIN_RST    8
#define PIN_BL     7

#define LCD_W     76
#define LCD_H    284
#define GAP_X     82
#define GAP_Y     18
#define LCD_HZ   (80 * 1000 * 1000)

#define FB_PIXELS (LCD_W * LCD_H)

#define HIST      72                 /* history samples == graph width in px */
#define SEC_H     54                 /* section pitch */
#define GRAPH_H   34
#define STALE_MS  3000

enum { M_CPU, M_RAM, M_RX, M_TX, M_BAT, NMETRIC };
static const char *const names[NMETRIC] = { "CPU", "RAM", "RX", "TX", "BAT" };

static esp_lcd_panel_handle_t panel;
static SemaphoreHandle_t trans_done;
static uint16_t *fb;
static int32_t hist[NMETRIC][HIST];  /* -1 == no value (battery on a desktop) */

/* 5x7 font, one byte per column, bit 0 = top row */
static const struct { char c; uint8_t col[5]; } font[] = {
    {'0', {0x3E, 0x51, 0x49, 0x45, 0x3E}}, {'1', {0x00, 0x42, 0x7F, 0x40, 0x00}},
    {'2', {0x42, 0x61, 0x51, 0x49, 0x46}}, {'3', {0x21, 0x41, 0x45, 0x4B, 0x31}},
    {'4', {0x18, 0x14, 0x12, 0x7F, 0x10}}, {'5', {0x27, 0x45, 0x45, 0x45, 0x39}},
    {'6', {0x3C, 0x4A, 0x49, 0x49, 0x30}}, {'7', {0x01, 0x71, 0x09, 0x05, 0x03}},
    {'8', {0x36, 0x49, 0x49, 0x49, 0x36}}, {'9', {0x06, 0x49, 0x49, 0x29, 0x1E}},
    {'.', {0x00, 0x60, 0x60, 0x00, 0x00}}, {'%', {0x23, 0x13, 0x08, 0x64, 0x62}},
    {'-', {0x08, 0x08, 0x08, 0x08, 0x08}}, {'A', {0x7E, 0x11, 0x11, 0x11, 0x7E}},
    {'B', {0x7F, 0x49, 0x49, 0x49, 0x36}}, {'C', {0x3E, 0x41, 0x41, 0x41, 0x22}},
    {'D', {0x7F, 0x41, 0x41, 0x22, 0x1C}}, {'K', {0x7F, 0x08, 0x14, 0x22, 0x41}},
    {'M', {0x7F, 0x02, 0x0C, 0x02, 0x7F}}, {'N', {0x7F, 0x04, 0x08, 0x10, 0x7F}},
    {'O', {0x3E, 0x41, 0x41, 0x41, 0x3E}}, {'P', {0x7F, 0x09, 0x09, 0x09, 0x06}},
    {'R', {0x7F, 0x09, 0x19, 0x29, 0x46}}, {'T', {0x01, 0x01, 0x7F, 0x01, 0x01}},
    {'U', {0x3F, 0x40, 0x40, 0x40, 0x3F}}, {'X', {0x63, 0x14, 0x08, 0x14, 0x63}},
};

/* RGB888 -> RGB565, byte-swapped for SPI */
static inline uint16_t rgb(uint8_t r, uint8_t g, uint8_t b)
{
    uint16_t c = ((r & 0xF8) << 8) | ((g & 0xFC) << 3) | (b >> 3);
    return (c >> 8) | (c << 8);
}

static bool IRAM_ATTR on_trans_done(esp_lcd_panel_io_handle_t io,
                                    esp_lcd_panel_io_event_data_t *ed, void *ctx)
{
    BaseType_t hp = pdFALSE;
    xSemaphoreGiveFromISR(trans_done, &hp);
    return hp == pdTRUE;
}

static void backlight_init(uint8_t duty)
{
    ledc_timer_config_t t = {
        .speed_mode = LEDC_LOW_SPEED_MODE, .timer_num = LEDC_TIMER_0,
        .duty_resolution = LEDC_TIMER_8_BIT, .freq_hz = 5000,
        .clk_cfg = LEDC_AUTO_CLK };
    ESP_ERROR_CHECK(ledc_timer_config(&t));
    ledc_channel_config_t c = {
        .gpio_num = PIN_BL, .speed_mode = LEDC_LOW_SPEED_MODE,
        .channel = LEDC_CHANNEL_0, .timer_sel = LEDC_TIMER_0, .duty = duty };
    ESP_ERROR_CHECK(ledc_channel_config(&c));
}

static void lcd_init(void)
{
    spi_bus_config_t bus = {
        .sclk_io_num = PIN_SCK, .mosi_io_num = PIN_MOSI, .miso_io_num = -1,
        .quadwp_io_num = -1, .quadhd_io_num = -1,
        .max_transfer_sz = FB_PIXELS * 2 };
    ESP_ERROR_CHECK(spi_bus_initialize(SPI2_HOST, &bus, SPI_DMA_CH_AUTO));

    esp_lcd_panel_io_handle_t io;
    esp_lcd_panel_io_spi_config_t io_cfg = {
        .cs_gpio_num = PIN_CS, .dc_gpio_num = PIN_DC,
        .spi_mode = 0, .pclk_hz = LCD_HZ,
        .trans_queue_depth = 10, .lcd_cmd_bits = 8, .lcd_param_bits = 8,
        .on_color_trans_done = on_trans_done };
    ESP_ERROR_CHECK(esp_lcd_new_panel_io_spi((esp_lcd_spi_bus_handle_t)SPI2_HOST, &io_cfg, &io));

    esp_lcd_panel_dev_config_t pcfg = {
        .reset_gpio_num = PIN_RST,
        .rgb_ele_order = LCD_RGB_ELEMENT_ORDER_RGB,
        .bits_per_pixel = 16 };
    ESP_ERROR_CHECK(esp_lcd_new_panel_st7789(io, &pcfg, &panel));

    ESP_ERROR_CHECK(esp_lcd_panel_reset(panel));
    ESP_ERROR_CHECK(esp_lcd_panel_init(panel));
    ESP_ERROR_CHECK(esp_lcd_panel_invert_color(panel, true));   /* IPS */
    ESP_ERROR_CHECK(esp_lcd_panel_set_gap(panel, GAP_X, GAP_Y));
    ESP_ERROR_CHECK(esp_lcd_panel_disp_on_off(panel, true));
}

static void fill_rect(int x, int y, int w, int h, uint16_t c)
{
    if (x < 0) { w += x; x = 0; }
    if (y < 0) { h += y; y = 0; }
    if (x + w > LCD_W) w = LCD_W - x;
    if (y + h > LCD_H) h = LCD_H - y;
    for (int j = 0; j < h; j++)
        for (int i = 0; i < w; i++)
            fb[(y + j) * LCD_W + x + i] = c;
}

static int text_w(const char *s, int scale)
{
    return (int)strlen(s) * 6 * scale - scale;
}

static void draw_text(int x, int y, int scale, uint16_t color, const char *s)
{
    for (; *s; s++, x += 6 * scale) {
        const uint8_t *g = NULL;
        for (size_t i = 0; i < sizeof(font) / sizeof(font[0]); i++)
            if (font[i].c == *s) { g = font[i].col; break; }
        if (!g) continue;
        for (int cx = 0; cx < 5; cx++)
            for (int cy = 0; cy < 7; cy++)
                if (g[cx] & (1 << cy))
                    fill_rect(x + cx * scale, y + cy * scale, scale, scale, color);
    }
}

static void push_sample(int m, int32_t v)
{
    memmove(hist[m], hist[m] + 1, (HIST - 1) * sizeof(hist[m][0]));
    hist[m][HIST - 1] = v;
}

/* wait for the previous frame, draw everything, send */
static void render(bool stale)
{
    xSemaphoreTake(trans_done, portMAX_DELAY);
    memset(fb, 0, FB_PIXELS * 2);

    for (int m = 0; m < NMETRIC; m++) {
        const int y0 = 2 + m * SEC_H;
        const bool net = (m == M_RX || m == M_TX);
        const int32_t cur = hist[m][HIST - 1];
        char buf[24];
        uint16_t col;

        int32_t full = 100;                       /* percent metrics; net autoscales */
        if (net) {
            full = 100;                           /* KB/s floor so idle noise stays flat */
            for (int i = 0; i < HIST; i++)
                if (hist[m][i] > full) full = hist[m][i];
        }

        if (cur < 0)           snprintf(buf, sizeof(buf), "--");
        else if (!net)         snprintf(buf, sizeof(buf), "%d%%", (int)cur);
        else if (cur < 1000)   snprintf(buf, sizeof(buf), "%dK", (int)cur);
        else                   snprintf(buf, sizeof(buf), "%d.%dM", (int)(cur / 1024), (int)(cur * 10 / 1024 % 10));

        if (m == M_RX)         col = rgb(60, 200, 255);
        else if (m == M_TX)    col = rgb(255, 90, 220);
        else if (m == M_BAT)   col = cur >= 0 && cur < 20 ? rgb(255, 60, 60) : rgb(80, 220, 120);
        else                   col = cur < 60 ? rgb(80, 220, 120) : cur < 85 ? rgb(255, 210, 50) : rgb(255, 60, 60);

        draw_text(2, y0 + 4, 1, rgb(150, 150, 150), names[m]);
        draw_text(LCD_W - 2 - text_w(buf, 2), y0, 2, rgb(255, 255, 255), buf);

        const int gy = y0 + 16;
        fill_rect(2, gy, HIST, GRAPH_H, rgb(20, 20, 32));
        for (int i = 0; i < HIST; i++) {
            int32_t v = hist[m][i];
            if (v <= 0) continue;
            int h = (int)((int64_t)v * GRAPH_H / full);
            if (h < 1) h = 1;
            if (h > GRAPH_H) h = GRAPH_H;
            fill_rect(2 + i, gy + GRAPH_H - h, 1, h, col);
        }
    }

    if (stale)
        draw_text((LCD_W - text_w("NO DATA", 1)) / 2, 274, 1, rgb(255, 60, 60), "NO DATA");

    ESP_ERROR_CHECK(esp_lcd_panel_draw_bitmap(panel, 0, 0, LCD_W, LCD_H, fb));
}

/* "M cpu ram rx tx bat" */
static bool parse_line(const char *line)
{
    int cpu, ram, rx, tx, bat;
    if (sscanf(line, "M %d %d %d %d %d", &cpu, &ram, &rx, &tx, &bat) != 5)
        return false;
    push_sample(M_CPU, cpu);
    push_sample(M_RAM, ram);
    push_sample(M_RX, rx);
    push_sample(M_TX, tx);
    push_sample(M_BAT, bat);
    return true;
}

void app_main(void)
{
    trans_done = xSemaphoreCreateBinary();
    xSemaphoreGive(trans_done);

    fb = heap_caps_malloc(FB_PIXELS * 2, MALLOC_CAP_DMA | MALLOC_CAP_INTERNAL);
    assert(fb);
    for (int m = 0; m < NMETRIC; m++)
        for (int i = 0; i < HIST; i++) hist[m][i] = (m == M_BAT) ? -1 : 0;

    usb_serial_jtag_driver_config_t usb_cfg = USB_SERIAL_JTAG_DRIVER_CONFIG_DEFAULT();
    ESP_ERROR_CHECK(usb_serial_jtag_driver_install(&usb_cfg));

    backlight_init(0);
    lcd_init();

    bool have_data = false, stale = true;
    TickType_t last_rx = 0;
    render(stale);                                       /* first frame before the light comes up */

    for (int d = 0; d <= 220; d += 4) {                  /* fade-in backlight */
        ledc_set_duty(LEDC_LOW_SPEED_MODE, LEDC_CHANNEL_0, d);
        ledc_update_duty(LEDC_LOW_SPEED_MODE, LEDC_CHANNEL_0);
        vTaskDelay(pdMS_TO_TICKS(10));
    }
    ESP_LOGI(TAG, "waiting for host data on USB");

    char line[48];
    int n = 0;
    while (1) {
        uint8_t rx[32];
        int got = usb_serial_jtag_read_bytes(rx, sizeof(rx), pdMS_TO_TICKS(200));
        bool dirty = false;

        for (int i = 0; i < got; i++) {
            char c = (char)rx[i];
            if (c == '\n') {
                line[n] = 0;
                if (parse_line(line)) { have_data = true; last_rx = xTaskGetTickCount(); dirty = true; }
                n = 0;
            } else if (c != '\r' && n < (int)sizeof(line) - 1) {
                line[n++] = c;
            }
        }

        bool now_stale = !have_data || (xTaskGetTickCount() - last_rx) > pdMS_TO_TICKS(STALE_MS);
        if (dirty || now_stale != stale) {
            stale = now_stale;
            render(stale);
        }
    }
}
